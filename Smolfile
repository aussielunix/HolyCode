# HolyCode v1.2.9 as a smolvm microVM with rootless Podman inside (see
# https://smolmachines.com/docs/guides/docker-in-a-machine)
#
# The smolvm rootfs is an overlay, so container storage cannot nest on it.
# Rootless Podman's graphroot MUST live on the machine's dedicated /storage ext4
# disk (allocated by `storage = 40`). It is prepared against /storage/containers
# via the baked `start-podman` helper (see Dockerfile).
image = "ghcr.io/aussielunix/holycode:v1.4.0"

cpus = 4
memory = 8192
# Expose the host's virtualization extensions so QEMU/KVM can run inside the
# machine (/dev/kvm). This is a CLI flag, not a Smolfile field: pass `--nested`
# to `smolvm machine create`/`run`.
net = true
storage = 40

# Expose the guest /var/run/docker.sock to the host over vsock so a host Docker
# or Podman client can drive the in-VM API (DOCKER_HOST=unix://<vm-data-dir>/docker.sock).
# start-podman bridges /var/run/docker.sock to the rootless Podman API socket.
docker_socket = true

user = "1000:1000"
workdir = "/home/agent1/Code"

# `init` always runs as root. Recursively chown the home (including any root-owned
# leftovers) and create the rootless Podman graphroot on the /storage ext4 disk.
init = [
  "chown -R 1000:1000 /home/agent1 2>/dev/null || true",
  "mkdir -p /storage/containers",
  "chown 1000:1000 /storage/containers",
]

# TOML does NOT expand $HOME/$PWD — use literal absolute host paths.
volumes = [
  "/home/lunix/holycode/.config:/home/agent1/.config",
  "/home/lunix/Code/github.com/aussielunix/HolyCode:/home/agent1/Code",
]

# Prepare rootless Podman storage on the /storage ext4 disk (as root via sudo),
# then keep the machine alive. Interactive bash is opened separately with
# `smolvm machine exec -it --name goose -- /bin/bash` (or the `smol` helper).
cmd = ["sh", "-c", "sudo start-podman >/dev/null 2>&1; exec sleep infinity"]
